{
  "name": "java-retro-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pwa": "vite preview --host 127.0.0.1 --port 5173",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test": "vitest run",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "fixtures:build": "node scripts/build-java.mjs",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --config playwright.webkit.config.ts"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
